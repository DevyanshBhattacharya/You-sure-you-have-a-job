# Copy to .env and fill in. .env is gitignored.

# ---- Backend selection ----
# "gemini" = hosted (needs a key, has per-day free-tier quotas)
# "ollama" = local (no key, no quota, slower)
LLM_PROVIDER=gemini

# ---- Ollama (local) ----
# Install: winget install Ollama.Ollama    then:  ollama serve
# Pull:    ollama pull qwen3:4b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Leave blank to reuse OLLAMA_MODEL for question answering.
OLLAMA_QA_MODEL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Local inference on CPU is slow; a per-request minute is not unusual.
OLLAMA_TIMEOUT_SECONDS=300
# Context window in tokens. Do not lower this without reading the note below.
# Ollama defaults EVERY model to 4096 no matter its real capacity, then drops
# the overflow from the FRONT of the prompt - the system instruction and the
# question - with no error. The model then answers something it cannot read.
# A full email, or a tool result listing every application, clears 4096 easily.
OLLAMA_NUM_CTX=16384
# Context for classification, which is a different workload: its prompt is
# capped at roughly 2k tokens and its output is one small JSON object, so the
# chat window above is waste - and not free waste. A window's KV cache is
# allocated in VRAM next to the model weights, so an oversized one evicts layers
# to the CPU. On qwen3:4b (5.1 GB), 16384 left only 2.6 GB resident and one
# classification ran past ten minutes. Raise this only if you see truncation
# warnings from the classifier.
OLLAMA_EXTRACTION_NUM_CTX=6144
# Leave true for reasoning models (qwen3, deepseek-r1). Setting it false does
# NOT stop them reasoning; it stops Ollama separating the reasoning into its own
# field, so it lands in the answer instead. Only set false for a plain model.
OLLAMA_THINK=true

# ---- Gemini ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs. Verify what your key can actually reach with:
#   python -c "from google import genai; [print(m.name) for m in genai.Client().models.list()]"
# and adjust these if the lineup has moved on.
CLASSIFIER_MODEL=gemini-2.5-flash
QA_MODEL=gemini-2.5-pro
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# ---- Gmail ----
# Path to the OAuth client secret downloaded from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Desktop app).
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Loopback port used during the consent flow.
# A "Desktop app" OAuth client accepts any port, so this value doesn't matter.
# A "Web application" client only accepts redirect URIs you registered — set
# this to match one of them exactly (register http://localhost:8080/ ).
OAUTH_REDIRECT_PORT=8080

# ---- Storage ----
DATABASE_URL=sqlite:///./data/agent.db

# ---- Watcher ----
POLL_INTERVAL_SECONDS=60
BACKFILL_DEFAULT_DAYS=90
# Restart an import that a crash or dropped connection left unfinished. Mail
# already stored is skipped, so this resumes rather than re-importing.
RESUME_BACKFILL_ON_START=true

# Run the very first import automatically, so a fresh install fills itself in
# instead of waiting for someone to find the "Import mail" button. Only fires
# while no import has ever completed; after that the watcher keeps up.
AUTO_BACKFILL_ON_START=true

# How often to re-sweep for imported-but-unclassified mail. The startup sweep is
# capped at BACKLOG_BATCH_LIMIT, and the work queue is in memory, so without
# this a remainder sits unprocessed until the next restart. 0 disables it.
BACKLOG_SWEEP_SECONDS=120

# ---- Server ----
# Exact origins allowed to call the API from a browser. Never "*": combined with
# credentialed requests that lets any site read this API from a logged-in
# browser. Also used to vet the Origin on WebSocket handshakes, which CORS does
# not cover at all.
CORS_ORIGINS=http://localhost:5173

# ---- Access control ----
# Shared secret required by every /api and /ws route. Leave EMPTY for local use
# bound to 127.0.0.1. Set it before this host is reachable from anywhere else:
# without it, `GET /api/emails/1` returns the text of your mail to whoever asks,
# and /api/chat will summarise the rest.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Setting it also turns off /docs, /redoc and /openapi.json.
# Serve over HTTPS when you set this — a bearer token on plain HTTP is readable
# by anything on the path.
APP_AUTH_TOKEN=
